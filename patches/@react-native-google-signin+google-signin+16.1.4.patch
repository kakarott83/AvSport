+// Shim added via patch-package — see patches/@react-native-google-signin+google-signin+16.1.4.patch
+//
+// Expo's `resolvePluginForModule` (used by the VS Code "Expo Tools" extension)
+// runs `findUp("package.json")` from the *resolved package entry file*. Because
+// this package ships a nested `lib/module/package.json` ({"type":"module"}),
+// findUp stops there instead of at the package root, so the resolver looks for
+// `lib/module/app.plugin.js`. Not finding it, it falls back to require()-ing the
+// ESM `lib/module/index.js` directly, which blows up with ERR_MODULE_NOT_FOUND
+// on its extensionless relative imports.
+//
+// Providing this file lets the resolver load the real config plugin (the
+// CommonJS build under `plugin/`) instead. This directory is ESM
+// ("type":"module"), so the shim itself must be written as ESM.
+import plugin from '../../plugin/build/withGoogleSignIn.js';
+
+export default plugin.default ?? plugin;
